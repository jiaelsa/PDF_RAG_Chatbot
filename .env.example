# Copy to .env and fill in. .env is git-ignored -- never commit real keys.

# ---- LLM (any OpenAI-compatible endpoint) --------------------------------
# Groq (free tier):   https://console.groq.com/keys
LLM_API_KEY=your-api-key-here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Model names change over time -- if you get a "model not found" error, pick a current
# one from your provider's model list.
#
# Other providers (change the three lines above):
#   OpenAI : https://api.openai.com/v1                                  model: gpt-4o-mini
#   Gemini : https://generativelanguage.googleapis.com/v1beta/openai/   model: gemini-2.0-flash (check current)
#   Ollama : http://localhost:11434/v1   (no key needed)                 model: llama3.2
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700

# ---- Embeddings / chunking (optional) -------------------------------------
# EMBEDDING_BACKEND=sentence-transformers   # or "onnx" (lighter, no PyTorch)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# CHUNK_SIZE=1000
# CHUNK_OVERLAP=200
# CHROMA_DIR=./storage/chroma
